# 복사해서 .env로 사용 (전부 선택 — 기본값 있음)

# 두 서버 공유 데이터 디렉토리 (기본: ~/familog-data)
#FAMILOG_DATA_DIR=~/familog-data

# CosyVoice2 가중치 경로 (기본: pretrained_models/CosyVoice2-0.5B)
#COSYVOICE_MODEL_DIR=pretrained_models/CosyVoice2-0.5B

# cosyvoice(기본) | mock — mock은 macOS say로 대체 (모델 없이 계약 테스트용)
#TTS_ENGINE=cosyvoice

# 아바타 생성(OpenAI 이미지 API)용 — 필수
OPENAI_API_KEY=
